{
  "name": "@matthewgallo/react-ol-map",
  "version": "1.0.1",
  "description": "Interactive OpenLayers maps for React, styled with Radix Themes: stacked area and marker layers with shared hover, selection, details panels and clustering.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewgallo/react-ol-map.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "@radix-ui/themes": "^3.3.0",
    "ol": "^10.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@types/geojson": "^7946.0.16",
    "ol-pmtiles": "^2.0.2",
    "radix-ui": "^1.8.1",
    "react-openlayers": "^10.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@radix-ui/themes": "^3.3.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "ol": "^10.11.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
